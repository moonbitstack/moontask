// Behaviour that only a running event loop can show: workers, retries over time,
// the canvas advancing across messages, and the beat's clock. The package holds
// only tests.
//
// Native-only because these tests wait, and the WebAssembly targets of the
// event loop have no timer; everything that does not wait is tested in the
// package it belongs to, where all four targets run it.
import {
  "moonbitstack/moontask",
  "moonbitstack/moontask/spec",
  "moonbitlang/async",
  "moonbitstack/moondate/cron",
} for "test"

supported_targets = "native"
