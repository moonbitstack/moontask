// Two tasks declared with `#task.def`. `jobs.g.mbt` comes from `cmd/tasks`; a project wires it as a
// dev_build rule.
import {
  "moonbitstack/moontask",
  "moonbitstack/moontask/wait",
  "moonbitlang/async",
  "moonbitlang/core/json",
}

// The runtime that drives an `async fn main` is native only, so these examples
// are too. The library they exercise builds for every target.

supported_targets = "native"

pkgtype(kind: "executable")

formatter(ignore: [ "jobs.g.mbt" ])
