///|
/// The tasks this package declares with `#task.def`, as typed handles on the app they were
/// registered on.
pub struct Tasks {
  place : @moontask.Task[Order, String]
  tick : @moontask.Task[Unit, Unit]
}

///|
/// Register every `#task.def` of this package on `app`, under its name and policy, and return the
/// handles. A worker calls it to run the tasks; a producer calls it to send them.
pub fn register_tasks(app : @moontask.App) -> Tasks {
  {
    place: app.task(
      "orders.place",
      (arg : Order, ctx : @moontask.Context) => place(arg, ctx),
      policy=@moontask.Policy::{
        ..@moontask.policy,
        queue: "orders",
        retries: 1,
      },
    ),
    tick: app.task("tick", (_ : Unit, _ : @moontask.Context) => tick()),
  }
}
